#!/usr/bin/env bash
set -eo pipefail
source /root/pd/settings.sh
unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY
exec python3 /vllm-workspace/vllm-ascend/examples/disaggregated_prefill_v1/load_balance_proxy_layerwise_server_example.py \
  --host {{ hostvars['p0'].ip }} --port {{ proxy_port }} \
  --prefiller-hosts {% for node in groups['prefill'] %}{% for local_rank in range(dp_local) %}{{ hostvars[node].ip }} {% endfor %}{% endfor %} \
  --prefiller-ports {% for rank in range(dp_size) %}{{ prefill_config.api_port + rank }} {% endfor %} \
  --decoder-hosts {% for node in groups['decode'] %}{% for local_rank in range(dp_local) %}{{ hostvars[node].ip }} {% endfor %}{% endfor %} \
  --decoder-ports {% for rank in range(dp_size) %}{{ decode_config.api_port + rank }} {% endfor %} \
  > "$LOG_PATH/proxy.log" 2>&1
