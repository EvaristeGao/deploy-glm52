# haproxy.cfg — ETCD 代理（对齐 ha_script/gen_haproxy_etcd.sh）
# 前端: bind *:{{ haproxy.listen_start_port }}; 后端: roundrobin 到 3 个 etcd (ssl verify none, client.pem, sni, alpn h2)
# mooncake_master 的 -etcd_endpoints 指向本 haproxy:127.0.0.1:{{ haproxy.listen_start_port }}
global
    log         127.0.0.1 local0
    maxconn     4096
    daemon

defaults
    log                     global
    mode                    tcp
    option                  tcplog
    timeout connect         10s
    timeout client          30s
    timeout server          30s
    timeout check           10s
    timeout tunnel          1h

frontend etcd_front
    bind *:{{ haproxy.listen_start_port }}
    mode tcp
    option tcplog
    default_backend etcd_backend

backend etcd_backend
    mode tcp
    balance roundrobin
{% for n in etcd.nodes %}
    # etcd 节点 {{ loop.index }}
    server etcd-{{ loop.index }} {{ hostvars[n].ansible_host }}:{{ etcd.client_port }} ssl verify none crt {{ etcd.client_cert | default('/etc/pki/etcd/certs/client.pem') }} sni str({{ hostvars[n].ansible_host }}) alpn h2 check
{% endfor %}