#!/usr/bin/bash
# run_dp_decode_template.sh.j2 — Decode 节点模板（P/D 分离 kv_consumer；KV 池/直连见 mooncake.enabled）
# 由 Ansible template 模块渲染。部署期变量（Jinja2）来源同 prefill 模板：
#   ip ← inventory 节点静态字段（真实网卡 IP）；其余来自 group_vars 平铺 / 集群配置
# 运行时引擎差异（端口/rank/dp/tp 等）由 launch_online_dp.py 以位置参数 $1..$7 传入，
#   与 deploy.sh 原模板 templates/run_dp_decode_template.sh 一致（decode 节点 dp_size_local=2
#   需拉起多个引擎，端口/rank 必须每次不同，绝不能固化成模板常量）。
{# 可读性约定：Jinja 块标签一律顶格独立成行（Ansible 模板 trim_blocks 会吃掉标签行换行，
   渲染结果无多余空行）；同一行内仅取值的分支用内联条件表达式（'A' if cond else 'B'）。 #}
{# v0.30 文档档位标记：开关搬进 additional-config、env 精简集（见 group_vars pd_cluster.v030_env） #}
{% set v030 = pd_cluster.v030_env | default(false) %}
nic_name="{{ nic }}"
local_ip="{{ ip }}"

export HCCL_IF_IP=$local_ip
export GLOO_SOCKET_IFNAME=$nic_name
export TP_SOCKET_IFNAME=$nic_name
export HCCL_SOCKET_IFNAME=$nic_name
{# VLLM_HOST_IP：A2 直连形态需要；A3 官方参考无此变量 #}
{% if cluster_type != "a3" %}
export VLLM_HOST_IP=$local_ip
{% endif %}

{% if not v030 %}
export OMP_PROC_BIND=false
{% endif %}
{# ---- 环境变量（a2/a3 每集群差异；a3 走灵衢 UB，a2 为常规昇腾栈）。
   v030 档（v0.30 文档）不设 OMP_*，由下面的 v0.30 env 集替代 ---- #}
{% if cluster_type == "a3" and not v030 %}
export OMP_NUM_THREADS=1
{% elif cluster_type != "a3" %}
export OMP_NUM_THREADS=10
{% endif %}
export PYTORCH_NPU_ALLOC_CONF=expandable_segments:True
{# MLAPO：v0.23 口径为 A3 decode 用 env 开；v0.30 改为 additional-config 的 enable_mlapo #}
{% if cluster_type != "a3" or not v030 %}
export VLLM_ASCEND_ENABLE_MLAPO=1
{% endif %}
{# HCCL_BUFFSIZE：官方 A3 参考里 decode 是分档的（198K=256 / 1M=400），故可配；
   未配置时回落集群默认（a3=400，a2=2560） #}
export HCCL_BUFFSIZE={{ pd_cluster.decode.hccl_buffsize | default('400' if cluster_type == "a3" else '2560') }}
{% if not v030 %}
export TASK_QUEUE_ENABLE=1
{% endif %}
export HCCL_OP_EXPANSION_MODE="AIV"

{% if cluster_type != "a3" %}
export VLLM_USE_V1=1
{% endif %}
export ASCEND_RT_VISIBLE_DEVICES=$1
{% if cluster_type == "a3" %}
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/lib
{% else %}
export LD_LIBRARY_PATH=/usr/local/python3.11.10/lib:/usr/local/lib:$LD_LIBRARY_PATH
{% endif %}
{% if cluster_type == "a3" and not v030 %}
export ASCEND_A3_ENABLE=1
export VLLM_ASCEND_ENABLE_FUSED_MC2=1
export HCCL_TRANSFER_TIMEOUT=600
export HCCL_EXEC_TIMEOUT=3600
export HCCL_CONNECT_TIMEOUT=3600
{% endif %}
{# ---- v0.30 §5.2.3 env 集（文档里只剩这几个；开关走 additional-config） ---- #}
{% if v030 %}
export VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS={{ pd_cluster.execute_model_timeout_seconds | default(30000) }}
export MF_GROUP_JOIN_MAX_TIMEOUT={{ pd_cluster.mf_group_join_max_timeout | default(1200) }}
{% if pd_cluster.use_fastokens | default(true) %}
export VLLM_USE_FASTOKENS=1
{% endif %}
{% endif %}

export PYTHONHASHSEED=0
{% if mooncake.enabled %}
export MOONCAKE_CONFIG_PATH="{{ mooncake_config_path }}"
{% endif %}
{# cluster_type = a2 时启用 RoCE；a3 走灵衢 UB，不启用 #}
{% if cluster_type == "a2" %}
export HCCL_INTRA_ROCE_ENABLE=1
{% endif %}
{# ACL_OP_INIT_MODE：v0.30 文档已删除该 env，v030 档不渲染 #}
{% if not v030 %}
export ACL_OP_INIT_MODE=1
{% endif %}
{# ---- runtime.timeouts（v030 档由 v0.30 env 集的 VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS 等覆盖） ---- #}
{% if runtime.timeouts is defined %}
export VLLM_RPC_TIMEOUT={{ runtime.timeouts.vllm_rpc_timeout }}
export VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS={{ runtime.timeouts.execute_model_timeout_seconds }}
export HCCL_EXEC_TIMEOUT={{ runtime.timeouts.hccl_exec_timeout }}
export HCCL_CONNECT_TIMEOUT={{ runtime.timeouts.hccl_connect_timeout }}
{% endif %}

{# ---- vllm serve 集群差异参数（a3 灵衢 UB 精简推理配置；a2 完整推理配置） ---- #}
{# additional-config：优先取 pd_cluster.decode.additional_config（分档配置，如 A3 1M 按官方参考），
   未配置则回落到按 cluster_type 的集群默认值（200K / A2 行为不变） #}
{% if pd_cluster.decode.additional_config is defined %}
{% set additional_config = pd_cluster.decode.additional_config %}
{% elif cluster_type == "a3" %}
{% set additional_config = '{"recompute_scheduler_enable":true, "enable_sparse_li_c8": true}' %}
{% else %}
{% set additional_config = '{"enable_flashcomm1": false, "enable_dsa_cp": false, "ascend_compilation_config": {"enable_npugraph_ex": true, "enable_static_kernel": false}, "fuse_muls_add": true, "multistream_overlap_shared_expert": true, "enable_mc2_hierarchy_comm": false, "enable_sparse_sfa_c8": false, "enable_sparse_li_c8": true, "enable_cpu_binding": true, "recompute_scheduler_enable": true}' %}
{% endif %}
vllm serve {{ model_path }} \
    --host 0.0.0.0 \
    --port $2 \
    --data-parallel-size $3 \
    --data-parallel-rank $4 \
    --data-parallel-address $5 \
    --data-parallel-rpc-port $6 \
    --tensor-parallel-size $7 \
    --enable-expert-parallel \
{# ---- prefix caching：官方 A3 PD 参考的 decode 脚本一律不带此参数（vLLM 默认关，等价 --no-enable-）；
   默认开以保持 A2 与既有渲染不变，A3 各档在 group_vars 里显式给 false ---- #}
{% if pd_cluster.decode.enable_prefix_caching | default(true) %}
    --enable-prefix-caching \
{% else %}
    --no-enable-prefix-caching \
{% endif %}
    --seed 1024 \
    --served-model-name {{ served_model_name }} \
    --async-scheduling \
    --max-model-len {{ max_model_len }} \
    --max-num-batched-tokens {{ pd_cluster.decode.max_num_batched_tokens | default('192' if cluster_type == "a3" else '256') }} \
    --trust-remote-code \
    --max-num-seqs {{ pd_cluster.decode.max_num_seqs | default('32' if cluster_type == "a3" else '128') }} \
    --gpu-memory-utilization {{ pd_cluster.decode.gpu_memory_utilization | default('0.92') }} \
{# ---- safetensors 预取：A2 默认开；A3 由 pd_cluster.decode.safetensors_prefetch 控制（v0.30 文档为开） ---- #}
{% if pd_cluster.decode.safetensors_prefetch | default(cluster_type != "a3") %}
    --safetensors-load-strategy prefetch \
{% endif %}
    --quantization ascend \
{# ---- KV cache 量化（v0.30 新增）：--kv-cache-dtype + --attention_config.indexer_kv_dtype。
   注意 v0.30 文档说明这两项即「SFA/LI 稀疏注意力 + C8 reshape 优化」的开关 ---- #}
{% if pd_cluster.decode.kv_cache_dtype is defined %}
    --kv-cache-dtype {{ pd_cluster.decode.kv_cache_dtype }} \
{% endif %}
{% if pd_cluster.decode.indexer_kv_dtype is defined %}
    --attention_config.indexer_kv_dtype {{ pd_cluster.decode.indexer_kv_dtype }} \
{% endif %}
{# ---- 对外 API ----
   api_server_count：配了就渲染（v0.30 文档给 p0/d0 写 1；external LB 模式下默认本就是 1）
   non_master_headless：非首节点加 --headless。**本项目必须保持 false**：
     vLLM 在 external/hybrid DP LB 模式下（即用了 --data-parallel-rank）要求 remote engine
     自己起 API server、禁止 --headless
     （vllm/v1/engine/utils.py: "Remote engine N must not use --headless in external or
      hybrid dp lb mode"），而 launch_online_dp.py 正是这种模式。 #}
{# 二者互斥：vLLM 会拒绝 --api-server-count 与 --headless 同时出现 #}
{% set _headless_here = (pd_cluster.decode.non_master_headless | default(false)) and (idx | default(0) | int > 0) %}
{% if _headless_here %}
    --headless \
{% elif pd_cluster.decode.api_server_count is defined %}
    --api-server-count {{ pd_cluster.decode.api_server_count }} \
{% endif %}
    --enable-auto-tool-choice \
    --tool-call-parser glm47 \
    --reasoning-parser glm45 \
{# ---- CP 上下文并行 ---- #}
{% if pd_cluster.prefill.context_parallel_size is defined %}
    --prefill-context-parallel-size {{ pd_cluster.prefill.context_parallel_size }} \
    --decode-context-parallel-size {{ pd_cluster.decode.context_parallel_size }} \
    --cp-kv-cache-interleave-size {{ pd_cluster.cp_kv_cache_interleave_size }} \
{% endif %}
{# ---- kv-transfer-config：enabled=true → MultiConnector(Ascend Store KV 池)；false → 直连 MooncakeConnectorV1 ---- #}
{% if mooncake.enabled %}
    --kv-transfer-config \
    '{
    "kv_connector": "MultiConnector",
    "kv_role": "kv_consumer",
    "kv_load_failure_policy": "recompute",
    "kv_connector_extra_config": {
        "connectors": [
            {
                "kv_connector": "MooncakeConnectorV1",
                "kv_role": "kv_consumer",
                "kv_port": "{{ kv_port }}",
                "kv_connector_extra_config": {
                    "prefill": { "dp_size": {{ prefill_dp }}, "tp_size": {{ prefill_tp }} },
                    "decode": { "dp_size": {{ decode_dp }}, "tp_size": {{ decode_tp }} }
                }
            },
            {
                "kv_connector": "AscendStoreConnector",
                "kv_role": "kv_consumer",
                "kv_connector_extra_config": {
                    "lookup_rpc_port":"0",
                    "load_async": true,
                    "backend": "mooncake"
                }
            }
        ]
    }
    }' \
{% else %}
    --kv-transfer-config \
    '{
    "kv_connector": "MooncakeConnectorV1",
    "kv_role": "kv_consumer",
    "kv_port": "{{ kv_port }}",
    "engine_id": "{{ pd_cluster.decode.engine_id | default('2') }}",
    "kv_connector_extra_config": {
        "use_ascend_direct": true,
        "prefill": { "dp_size": {{ prefill_dp }}, "tp_size": {{ prefill_tp }} },
        "decode": { "dp_size": {{ decode_dp }}, "tp_size": {{ decode_tp }} }
    }
    }' \
{% endif %}
    --compilation-config \
{% if cluster_type == "a3" %}
    '{"cudagraph_mode": "FULL_DECODE_ONLY"}' \
{% else %}
    '{
        "cudagraph_mode": "FULL_DECODE_ONLY",
        "cudagraph_capture_sizes": {{ pd_cluster.decode.capture_sizes | default([4,8,16,24,32,40,48,56,64,96,128,160,192,224,256,298,320,352,384]) }}
    }' \
{% endif %}
{# ---- hf-overrides（可选；官方 A3 198K 参考需要 use_index_cache/index_topk_freq，1M 参考无） ---- #}
{% if pd_cluster.decode.hf_overrides is defined %}
    --hf-overrides '{{ pd_cluster.decode.hf_overrides }}' \
{% endif %}
    --additional-config '{{ additional_config }}' \
{# ---- profiler ---- #}
{% if profiler is defined and (profiler.enabled | default(false)) %}
    --profiler-config \
    '{{ profiler.config }}' \
{% endif %}
{# ---- MTP 投机 token 数：官方 A3 参考分档（198K=3 / 1M=5），可配 ---- #}
    --speculative-config '{"num_speculative_tokens": {{ pd_cluster.decode.num_speculative_tokens | default('5' if cluster_type == "a3" else '3') }}, "method":"deepseek_mtp", "enforce_eager":true}'